generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
    ADMIN
    MANAGER
    MEMBER
}


model User {
    id String @id @default(cuid())
    email String @unique
    password String 
    name String
    avatar String?
    role Role @default(MEMBER)
    createdAt DateTime @default(now())
}